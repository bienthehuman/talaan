# Copy to .env for local development. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database. The running app and pytest connect as the least-privilege app role.
# Migrations run as the owner role (server/scripts/migrate.sh).
POSTGRES_DB=talaan
POSTGRES_TEST_DB=talaan_test
POSTGRES_USER=talaan_app
POSTGRES_PASSWORD=talaan_app_dev
POSTGRES_OWNER_USER=talaan_owner
POSTGRES_OWNER_PASSWORD=talaan_owner_dev
POSTGRES_SUPERUSER_PASSWORD=postgres_dev
POSTGRES_HOST=localhost
# 5434 so it does not clash with a local Postgres (5432) or another one on 5433
POSTGRES_PORT=5434

# Only ever set to 1 in dev/test. Enables the fault-injection middleware.
FAULT_INJECTION=0

# Minimum accepted client protocol version (426 below this)
MIN_CLIENT_SCHEMA=1

# Login rate limit and token lifetimes
THROTTLE_LOGIN=10/min
JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=7

# Structured logs: json or plain (default plain in debug, json otherwise)
LOG_FORMAT=plain
# GET /metrics: in debug it is open when this is empty; otherwise it needs `Authorization: Bearer <token>`
METRICS_TOKEN=
