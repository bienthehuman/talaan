# Copy to .env for local development. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=talaan
POSTGRES_USER=talaan
POSTGRES_PASSWORD=talaan
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Only ever set to 1 in dev/test. Enables the fault-injection middleware.
FAULT_INJECTION=0

# Minimum accepted client protocol version (426 below this)
MIN_CLIENT_SCHEMA=1
