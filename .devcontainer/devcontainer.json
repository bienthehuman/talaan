{
  "name": "Talaan",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" }
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb", "storage": "32gb" },
  "containerEnv": {
    "DJANGO_ALLOWED_HOSTS": "localhost,127.0.0.1,server,.github.dev,.app.github.dev",
    "DJANGO_CSRF_TRUSTED_ORIGINS": "https://*.app.github.dev",
    "FAULT_INJECTION": "1"
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Talaan", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "docker compose up -d --wait",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
