{
  "name": "talaan-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../server/openapi.yml -o src/lib/api-types.ts"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-window": "7.4.1"
  }
}
